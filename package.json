{
  "name": "@tuteliq/cli",
  "version": "3.0.0",
  "description": "Tuteliq CLI - AI-powered child safety analysis from your terminal",
  "type": "module",
  "bin": {
    "tuteliq": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tuteliq",
    "cli",
    "child-safety",
    "content-moderation",
    "ai"
  ],
  "author": "Tuteliq <sales@tuteliq.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tuteliq/cli.git"
  },
  "homepage": "https://tuteliq.ai",
  "dependencies": {
    "@tuteliq/sdk": "^3.2.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "conf": "^15.1.0",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
